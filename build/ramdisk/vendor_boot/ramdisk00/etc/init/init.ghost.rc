# ======================================================================
#   GHOST KERNEL: VENDOR-BOOT NATIVE INIT ACTIONS (Pillar 38)
#   Runs natively within init context (u:r:init:s0) — 100% immune to SELinux
# ======================================================================

on property:sys.boot_completed=1
    # 1. Neutralize DSMS Telemetry & Crash Loop
    setprop security.dsmsd.enable false
    stop dsmsd
    stop dsmsca

    # 2. Sanitize Boot Reason Properties
    setprop sys.boot.reason "reboot"
    setprop sys.boot.reason.last "reboot"
    setprop ro.boot.bootreason "reboot"

    # 3. Start fallback userspace helper if available
    start ghost_prop_sanitizer

service ghost_prop_sanitizer /system/bin/sh /vendor/etc/ghost_prop_sanitizer.sh
    class late_start
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:init:s0
